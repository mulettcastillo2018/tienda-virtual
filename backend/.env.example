# PostgreSQL (Neon, Supabase, u otro proveedor gestionado)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Autenticación (en producción, mínimo 32 caracteres aleatorios)
JWT_SECRET="reemplaza-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"
# Firma de los enlaces a adjuntos privados (si se omite, se usa JWT_SECRET)
# FILES_SIGNING_SECRET=""

# Wompi (ambiente Sandbox — https://comercios.wompi.co)
WOMPI_PUBLIC_KEY="pub_test_..."
WOMPI_PRIVATE_KEY="prv_test_..."
WOMPI_EVENTS_SECRET="test_events_..."
WOMPI_INTEGRITY_SECRET="test_integrity_..."

# Correo (Resend — https://resend.com)
RESEND_API_KEY=""
STORE_FROM_EMAIL="Tienda Virtual <onboarding@resend.dev>"

# Servidor
PORT=4000
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
# Detrás de un proxy (Render, Railway, Nginx): número de proxies de confianza.
# TRUST_PROXY=1

# Archivos subidos: "local" (disco del servidor, por defecto) o "s3"
# (Cloudflare R2, AWS S3 u otro compatible). Ver docs/DESPLIEGUE.md.
# STORAGE_DRIVER=local
# FILES_DIR=""              # modo local: carpeta base (por defecto, la del backend)
# PUBLIC_FILES_URL=""       # modo s3: dirección pública del bucket de imágenes
# S3_ENDPOINT="https://<cuenta>.r2.cloudflarestorage.com"
# S3_REGION=auto
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BUCKET="tienda-publico"
# S3_PRIVATE_BUCKET="tienda-privado"

# Contraseña del administrador que crea el seed (solo al crearlo; mínimo 12).
SEED_ADMIN_PASSWORD=""

# Minutos para pagar un pedido antes de que se cancele solo.
ORDER_PAYMENT_WINDOW_MINUTES=60

# Solo detrás de un proxy que bloquea la descarga de los motores de Prisma
# (ver docs/entorno-con-proxy.md). En una red normal, bórralas.
# PRISMA_QUERY_ENGINE_LIBRARY="./.prisma-engines/query_engine.dll.node"
# PRISMA_SCHEMA_ENGINE_BINARY="./.prisma-engines/schema-engine.exe"
