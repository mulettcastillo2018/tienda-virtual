generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  JURIDICO
  CUSTOMER
}

enum PqrsType {
  PETICION
  QUEJA
  RECLAMO
  SUGERENCIA
}

enum PqrsStatus {
  RECIBIDO
  EN_PROCESO
  RESUELTO
  CERRADO
}

model Pqrs {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation("PqrsSubmitted", fields: [userId], references: [id])
  type           PqrsType
  subject        String
  message        String
  attachmentUrl  String?
  status         PqrsStatus      @default(RECIBIDO)
  dueAt          DateTime
  orderId        String?
  order          Order?          @relation(fields: [orderId], references: [id])
  response       String?
  responseAttachmentUrl String?
  respondedById  String?
  respondedBy    User?           @relation("PqrsResponded", fields: [respondedById], references: [id])
  respondedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  statusLogs     PqrsStatusLog[]
}

model PqrsStatusLog {
  id          String      @id @default(cuid())
  pqrsId      String
  pqrs        Pqrs        @relation(fields: [pqrsId], references: [id], onDelete: Cascade)
  fromStatus  PqrsStatus?
  toStatus    PqrsStatus
  comment     String?
  attachmentUrl String?
  changedById String
  changedBy   User        @relation(fields: [changedById], references: [id])
  changedAt   DateTime    @default(now())
}

model Carrier {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String
  websiteUrl String
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model SocialLink {
  id        String   @id @default(cuid())
  name      String
  iconUrl   String
  url       String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model PaymentMethod {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String
  websiteUrl String
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model ContactInfo {
  id        String   @id @default("main")
  phone     String
  whatsapp  String
  email     String
  address   String
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  WOMPI
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  phone               String?
  passwordHash        String?
  provider            String?
  providerId          String?
  role                Role                  @default(CUSTOMER)
  isActive            Boolean               @default(true)
  // Va dentro de cada token de sesión. Al cambiar la contraseña, el rol o
  // desactivar la cuenta se incrementa, y todos los tokens anteriores dejan
  // de servir de inmediato.
  tokenVersion        Int                   @default(0)
  createdAt           DateTime              @default(now())
  oauthLoginCodes     OAuthLoginCode[]
  addresses           ShippingAddress[]
  cart                Cart?
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  pqrsSubmitted       Pqrs[]                @relation("PqrsSubmitted")
  pqrsResponded       Pqrs[]                @relation("PqrsResponded")
  pqrsStatusChanges   PqrsStatusLog[]
  discountLogsCreated ProductDiscountLog[]
  storeReviews        StoreReview[]
  orderStatusChanges  OrderStatusLog[]

  @@unique([provider, providerId])
}

// Al volver de Google/Facebook el navegador recibe este código (no el token
// de sesión, que quedaría en el historial y en los registros de servidores) y
// lo canjea una sola vez, en los 2 minutos siguientes, por el token.
model OAuthLoginCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  icon     String?
  products Product[]
}

model Product {
  id             String      @id @default(cuid())
  name           String
  description    String
  price          Int
  discountPercentage Int?
  discountEndsAt DateTime?
  brand          String?
  stock          Int         @default(0)
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  images         String[]
  weightInGrams  Int
  widthCm        Float
  heightCm       Float
  depthCm        Float
  sku            String      @unique
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  cartItems      CartItem[]
  orderItems     OrderItem[]
  discountLogs   ProductDiscountLog[]
}

model ProductDiscountLog {
  id                 String      @id @default(cuid())
  productId          String
  product            Product     @relation(fields: [productId], references: [id])
  discountPercentage Int
  startedAt          DateTime    @default(now())
  endsAt             DateTime
  createdById        String
  createdBy          User        @relation(fields: [createdById], references: [id])
  createdAt          DateTime    @default(now())
  orderItems         OrderItem[]
}

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([cartId, productId])
}

model ShippingAddress {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  fullName      String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  postalCode    String
  country       String              @default("CO")
  phone         String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  orders        Order[]
  changeLogs    AddressChangeLog[]
}

model AddressChangeLog {
  id           String          @id @default(cuid())
  addressId    String
  address      ShippingAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)
  previousData Json
  newData      Json
  changedAt    DateTime        @default(now())
}

model Order {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  totalAmount       Int
  shippingAddressId String
  shippingAddress   ShippingAddress @relation(fields: [shippingAddressId], references: [id])
  shippingCost      Int             @default(0)
  carrier           String?
  trackingNumber    String?
  status            OrderStatus     @default(PENDING)
  createdAt         DateTime        @default(now())
  // Hasta cuándo se puede pagar un pedido PENDING. Después se cancela solo y
  // el inventario reservado vuelve a estar disponible.
  expiresAt         DateTime?
  // Algo en el pago necesita que una persona lo revise (p. ej. un pago
  // aprobado sobre un pedido ya pagado, que hay que reembolsar).
  needsReview       Boolean         @default(false)
  reviewNote        String?
  items             OrderItem[]
  payments          Payment[]
  statusLogs        OrderStatusLog[]
  pqrsList          Pqrs[]
  storeReview       StoreReview?

  @@index([userId])
  @@index([status, expiresAt])
}

// Cada cambio de estado de un pedido: quién (null = el sistema: pago,
// vencimiento), de qué estado a cuál y por qué.
model OrderStatusLog {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  reason      String?
  changedById String?
  changedBy   User?        @relation(fields: [changedById], references: [id])
  changedAt   DateTime     @default(now())

  @@index([orderId])
}

// Reseña de la experiencia de compra/tienda en general. Solo puede dejarse
// una por pedido, y únicamente si ese pedido ya llegó a un estado de compra
// real (no PENDING/CANCELLED) — así garantizamos que sea de un cliente que
// efectivamente compró.
model StoreReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model OrderItem {
  id              String              @id @default(cuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id])
  productId       String
  product         Product             @relation(fields: [productId], references: [id])
  quantity        Int
  priceAtPurchase Int
  discountLogId   String?
  discountLog     ProductDiscountLog? @relation(fields: [discountLogId], references: [id])
}

// Un intento de pago (una referencia de Wompi). Un pedido puede tener varios:
// si el primero se rechaza, el cliente reintenta con otro medio.
model Payment {
  id                    String          @id @default(cuid())
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id])
  provider              PaymentProvider @default(WOMPI)
  providerTransactionId String?         @unique
  paymentMethod         String?
  // PENDING (sin transacción todavía o en trámite), APPROVED, DECLINED,
  // VOIDED o ERROR, tal como lo informa Wompi.
  status                String
  amountInCents         Int?
  paymentReference      String          @unique
  rawResponse           Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  @@index([orderId])
}
