generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  JURIDICO
  CUSTOMER
}

enum PqrsType {
  PETICION
  QUEJA
  RECLAMO
  SUGERENCIA
}

enum PqrsStatus {
  RECIBIDO
  EN_PROCESO
  RESUELTO
  CERRADO
}

model Pqrs {
  id                    String          @id @default(cuid())
  userId                String
  user                  User            @relation("PqrsSubmitted", fields: [userId], references: [id])
  type                  PqrsType
  subject               String
  message               String
  attachmentUrl         String?
  status                PqrsStatus      @default(RECIBIDO)
  dueAt                 DateTime
  orderId               String?
  order                 Order?          @relation(fields: [orderId], references: [id])
  response              String?
  responseAttachmentUrl String?
  respondedById         String?
  respondedBy           User?           @relation("PqrsResponded", fields: [respondedById], references: [id])
  respondedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  statusLogs            PqrsStatusLog[]

  @@index([userId])
  @@index([orderId])
}

model PqrsStatusLog {
  id            String      @id @default(cuid())
  pqrsId        String
  pqrs          Pqrs        @relation(fields: [pqrsId], references: [id], onDelete: Cascade)
  fromStatus    PqrsStatus?
  toStatus      PqrsStatus
  comment       String?
  attachmentUrl String?
  changedById   String
  changedBy     User        @relation(fields: [changedById], references: [id])
  changedAt     DateTime    @default(now())

  @@index([pqrsId])
}

model Carrier {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String
  websiteUrl String
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model SocialLink {
  id        String   @id @default(cuid())
  name      String
  iconUrl   String
  url       String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model PaymentMethod {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String
  websiteUrl String
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

model ContactInfo {
  id        String   @id @default("main")
  // Identificación del comerciante que se muestra en la tienda (Ley 1480 de
  // 2011, art. 50) y que va en las facturas electrónicas.
  legalName String   @default("")
  // NIT con dígito de verificación, p. ej. "900123456-7".
  nit       String   @default("")
  phone     String
  whatsapp  String
  email     String
  address   String
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  // Devuelto y reembolsado (retracto o reversión del pago).
  REFUNDED
}

enum PaymentProvider {
  WOMPI
  // Cobro en efectivo al entregar (contra entrega).
  CASH
}

// Cómo paga el cliente: en línea con Wompi o en efectivo al recibir.
enum PaymentOption {
  ONLINE
  CASH_ON_DELIVERY
}

// Configuración de la tienda (una sola fila, id "main").
model StoreSettings {
  id           String   @id @default("main")
  // Pago contra entrega: solo en estas ciudades y hasta este valor (con envío
  // y recargo), para controlar el riesgo de pedidos que no se reciben.
  codEnabled   Boolean  @default(false)
  codCities    String[] @default([])
  codMaxAmount Int      @default(500000)
  codFee       Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  phone               String?
  passwordHash        String?
  provider            String?
  providerId          String?
  role                Role                 @default(CUSTOMER)
  isActive            Boolean              @default(true)
  // Va dentro de cada token de sesión. Al cambiar la contraseña, el rol o
  // desactivar la cuenta se incrementa, y todos los tokens anteriores dejan
  // de servir de inmediato.
  tokenVersion        Int                  @default(0)
  // Autorización de tratamiento de datos (Ley 1581 de 2012): cuándo y qué
  // versión de la política aceptó; el detalle queda en ConsentRecord.
  privacyAcceptedAt   DateTime?
  privacyVersion      String?
  // Acepta recibir ofertas por correo o WhatsApp (aparte de la autorización).
  marketingOptIn      Boolean              @default(false)
  // Cuenta suprimida a pedido del titular: los datos personales se borraron
  // y solo queda lo que la ley obliga a conservar (pedidos y facturas).
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  oauthLoginCodes     OAuthLoginCode[]
  uploadedFiles       UploadedFile[]
  addresses           ShippingAddress[]
  cart                Cart?
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  pqrsSubmitted       Pqrs[]               @relation("PqrsSubmitted")
  pqrsResponded       Pqrs[]               @relation("PqrsResponded")
  pqrsStatusChanges   PqrsStatusLog[]
  discountLogsCreated ProductDiscountLog[]
  storeReviews        StoreReview[]
  orderStatusChanges  OrderStatusLog[]
  consents            ConsentRecord[]
  productReviews      ProductReview[]

  @@unique([provider, providerId])
}

// Cada archivo subido: quién lo subió y qué es. Una PQRS solo puede adjuntar
// archivos que subió la misma persona (no los de otra ni direcciones libres).
model UploadedFile {
  key       String   @id
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // "products" o "pqrs"
  kind      String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([ownerId])
}

// Al volver de Google/Facebook el navegador recibe este código (no el token
// de sesión, que quedaría en el historial y en los registros de servidores) y
// lo canjea una sola vez, en los 2 minutos siguientes, por el token.
model OAuthLoginCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  icon     String?
  products Product[]
}

model Product {
  id                 String               @id @default(cuid())
  name               String
  description        String
  price              Int
  discountPercentage Int?
  discountEndsAt     DateTime?
  brand              String?
  stock              Int                  @default(0)
  categoryId         String
  category           Category             @relation(fields: [categoryId], references: [id])
  images             String[]
  weightInGrams      Int
  widthCm            Float
  heightCm           Float
  depthCm            Float
  sku                String               @unique
  // Tarifa de IVA incluida en el precio: 19, 5 o 0 (excluido).
  taxRate            Int                  @default(19)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  cartItems          CartItem[]
  orderItems         OrderItem[]
  discountLogs       ProductDiscountLog[]
  reviews            ProductReview[]

  @@index([categoryId])
}

model ProductDiscountLog {
  id                 String      @id @default(cuid())
  productId          String
  product            Product     @relation(fields: [productId], references: [id])
  discountPercentage Int
  startedAt          DateTime    @default(now())
  endsAt             DateTime
  createdById        String
  createdBy          User        @relation(fields: [createdById], references: [id])
  createdAt          DateTime    @default(now())
  orderItems         OrderItem[]

  @@index([productId])
}

model Cart {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([cartId, productId])
  @@index([productId])
}

model ShippingAddress {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  fullName     String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String
  country      String             @default("CO")
  phone        String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  orders       Order[]
  changeLogs   AddressChangeLog[]

  @@index([userId])
}

model AddressChangeLog {
  id           String          @id @default(cuid())
  addressId    String
  address      ShippingAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)
  previousData Json
  newData      Json
  changedAt    DateTime        @default(now())

  @@index([addressId])
}

model Order {
  id                 String           @id @default(cuid())
  // Vacío en las compras como invitado: el cliente ve su pedido con un enlace
  // firmado y se le escribe a guestEmail.
  userId             String?
  user               User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  guestEmail         String?
  // Factura a nombre de alguien (null = consumidor final). Tipo de documento
  // de la DIAN: 13 cédula, 31 NIT, 22 cédula de extranjería, 41 pasaporte.
  billingIdType      String?
  billingIdNumber    String?
  billingName        String?
  totalAmount        Int
  shippingAddressId  String?
  shippingAddress    ShippingAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  // Copia de la dirección al momento de comprar: si el cliente la edita
  // después, el pedido se despacha a donde se pidió.
  shippingFullName   String?
  shippingLine1      String?
  shippingLine2      String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?
  shippingPhone      String?
  shippingCost       Int              @default(0)
  paymentOption      PaymentOption    @default(ONLINE)
  // Recargo por pago contra entrega (ya incluido en totalAmount).
  codFee             Int              @default(0)
  carrier            String?
  trackingNumber     String?
  status             OrderStatus      @default(PENDING)
  createdAt          DateTime         @default(now())
  // Hasta cuándo se puede pagar un pedido PENDING. Después se cancela solo y
  // el inventario reservado vuelve a estar disponible.
  expiresAt          DateTime?
  // Algo en el pago necesita que una persona lo revise (p. ej. un pago
  // aprobado sobre un pedido ya pagado, que hay que reembolsar).
  needsReview        Boolean          @default(false)
  reviewNote         String?
  items              OrderItem[]
  payments           Payment[]
  statusLogs         OrderStatusLog[]
  pqrsList           Pqrs[]
  storeReview        StoreReview?
  returnRequests     ReturnRequest[]
  fiscalDocuments    FiscalDocument[]
  consents           ConsentRecord[]
  productReviews     ProductReview[]

  @@index([userId])
  @@index([paymentOption, status])
  @@index([status, expiresAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([shippingAddressId])
}

// Cada cambio de estado de un pedido: quién (null = el sistema: pago,
// vencimiento), de qué estado a cuál y por qué.
model OrderStatusLog {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  reason      String?
  changedById String?
  changedBy   User?        @relation(fields: [changedById], references: [id])
  changedAt   DateTime     @default(now())

  @@index([orderId])
}

// Reseña de la experiencia de compra/tienda en general. Solo puede dejarse
// una por pedido, y únicamente si ese pedido ya llegó a un estado de compra
// real (no PENDING/CANCELLED) — así garantizamos que sea de un cliente que
// efectivamente compró.
model StoreReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([userId])
}

model OrderItem {
  id              String              @id @default(cuid())
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id])
  productId       String
  product         Product             @relation(fields: [productId], references: [id])
  quantity        Int
  priceAtPurchase Int
  // Tarifa de IVA con la que se vendió (no cambia si después se edita el producto).
  taxRate         Int                 @default(19)
  discountLogId   String?
  discountLog     ProductDiscountLog? @relation(fields: [discountLogId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// Un intento de pago (una referencia de Wompi). Un pedido puede tener varios:
// si el primero se rechaza, el cliente reintenta con otro medio.
model Payment {
  id                    String          @id @default(cuid())
  orderId               String
  order                 Order           @relation(fields: [orderId], references: [id])
  provider              PaymentProvider @default(WOMPI)
  providerTransactionId String?         @unique
  paymentMethod         String?
  // PENDING (sin transacción todavía o en trámite), APPROVED, DECLINED,
  // VOIDED o ERROR, tal como lo informa Wompi.
  status                String
  amountInCents         Int?
  paymentReference      String          @unique
  rawResponse           Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @default(now()) @updatedAt

  @@index([orderId])
}

// --- Ley 1581 de 2012: autorizaciones de tratamiento de datos ---

enum ConsentPurpose {
  // Tratar los datos para la relación con el cliente (pedidos, envíos, PQRS).
  DATA_PROCESSING
  // Enviar ofertas y novedades.
  MARKETING
}

// Prueba de cada autorización (o revocatoria): quién, para qué, qué versión
// de la política, cuándo y por qué canal. No se borra al suprimir la cuenta.
model ConsentRecord {
  id            String         @id @default(cuid())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id])
  email         String
  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String
  // REGISTRO, OAUTH, CHECKOUT_INVITADO o CUENTA.
  channel       String
  ipAddress     String?
  createdAt     DateTime       @default(now())

  @@index([userId])
  @@index([orderId])
}

// --- Ley 1480 de 2011: retracto (art. 47) y reversión del pago (art. 51) ---

enum ReturnType {
  RETRACTO
  REVERSION
}

enum ReturnStatus {
  // El cliente la pidió; la tienda la revisa.
  REQUESTED
  // Aceptada: el cliente devuelve el producto (o no hay producto que devolver).
  APPROVED
  // La tienda recibió el producto de vuelta.
  RECEIVED
  // Se devolvió el dinero: fin del trámite.
  REFUNDED
  // No procede (fuera de plazo, producto usado, causal no aplica...).
  REJECTED
}

model ReturnRequest {
  id              String       @id @default(cuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id])
  type            ReturnType
  status          ReturnStatus @default(REQUESTED)
  // Reversión: FRAUDE, NO_SOLICITADA, NO_RECIBIDO o DEFECTUOSO (art. 51).
  cause           String?
  customerNote    String?
  // Lo que respondió la tienda (motivo del rechazo, instrucciones de envío).
  storeNote       String?
  refundReference String?
  // Hasta cuándo se podía pedir (5 días hábiles).
  deadlineAt      DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  resolvedAt      DateTime?

  @@index([orderId])
  @@index([status, createdAt])
}

// --- Factura electrónica (DIAN) con Alanube ---

enum FiscalDocumentType {
  INVOICE
  // Anula (total) una factura: devoluciones y reembolsos.
  CREDIT_NOTE
}

enum FiscalDocumentStatus {
  // Todavía no se envió (sin conexión o sin configurar): se reintenta solo.
  PENDING
  // Alanube lo recibió; falta la respuesta de la DIAN.
  SENT
  ACCEPTED
  // La DIAN (o Alanube) lo rechazó: hay que corregir y reenviar.
  REJECTED
}

model FiscalSettings {
  id               String    @id @default("main")
  enabled          Boolean   @default(false)
  // Desde cuándo: los pedidos pagados antes no se facturan.
  enabledAt        DateTime?
  alanubeUrl       String    @default("https://sandbox-api.alegra.com/e-provider/col/v1")
  alanubeToken     String?
  alanubeCompanyId String?
  // Resolución de numeración de la DIAN.
  resolutionNumber String?
  prefix           String?
  rangeFrom        Int?
  rangeTo          Int?
  // Fechas como AAAA-MM-DD.
  startDate        String?
  endDate          String?
  technicalKey     String?
  nextNumber       Int?
  creditNotePrefix String    @default("NC")
  creditNoteNext   Int       @default(1)
  // IVA del envío y del recargo contra entrega (0 = excluido).
  shippingTaxRate  Int       @default(0)
  updatedAt        DateTime  @updatedAt
}

model FiscalDocument {
  id             String               @id @default(cuid())
  orderId        String
  order          Order                @relation(fields: [orderId], references: [id])
  type           FiscalDocumentType
  prefix         String
  number         Int
  status         FiscalDocumentStatus @default(PENDING)
  // Lo que se envía; si hay que reintentar por conexión, se reenvía igual.
  content        Json
  // Evita que un reintento cree el documento dos veces en la DIAN.
  idempotencyKey String               @unique
  alanubeId      String?
  // CUFE (factura) o CUDE (nota crédito).
  uniqueCode     String?
  qr             String?
  message        String?
  errors         String[]
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime             @default(now())
  customerName   String
  customerId     String
  total          Int
  // Factura que esta nota crédito anula.
  cancelsId      String?              @unique
  cancels        FiscalDocument?      @relation("Cancellation", fields: [cancelsId], references: [id])
  cancelledBy    FiscalDocument?      @relation("Cancellation")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([type, prefix, number])
  @@index([status, nextAttemptAt])
  @@index([orderId])
}

// Opinión de un comprador sobre un producto. Solo opina quien lo recibió (el
// pedido lo prueba); la tienda responde en público y solo oculta contenido
// ofensivo, con motivo: esconder las críticas sería publicidad engañosa.
model ProductReview {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id])
  rating       Int
  comment      String
  storeReply   String?
  repliedAt    DateTime?
  hiddenAt     DateTime?
  hiddenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([productId, userId])
  @@index([productId, hiddenAt])
  @@index([userId])
  @@index([orderId])
}
